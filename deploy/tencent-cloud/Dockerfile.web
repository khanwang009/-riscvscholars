FROM node:20-alpine AS builder

WORKDIR /app

ARG VITE_APP_BASE=/
ARG VITE_INTAKE_WEBHOOK_URL=

ENV VITE_APP_BASE=${VITE_APP_BASE}
ENV VITE_INTAKE_WEBHOOK_URL=${VITE_INTAKE_WEBHOOK_URL}

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/tencent-cloud/frontend-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
